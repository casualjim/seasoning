#!/usr/bin/env bash

#MISE description="Run the Rust tests for this project"
#MISE sources=["Cargo.toml", "src/**/*.rs"]

echo "🚀 Starting Frontend Rust tests..."
proj_dir=$(git rev-parse --show-toplevel)
cd "$proj_dir" || exit 1

set -euo pipefail

cargo nextest run
cargo nextest run --features local

case "$(uname -s)" in
  Darwin)
    cargo nextest run --features metal
    ;;
  *)
    echo "Skipping accelerator passthrough feature test runs in the default Rust gate; they require platform-specific native toolchains."
    ;;
esac
